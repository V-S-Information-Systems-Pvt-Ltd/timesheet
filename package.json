{
  "name": "vsis-timesheet",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-supabase-auth-config.mjs",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "node db/seed.mjs",
    "db:backup": "node scripts/backup-supabase.mjs",
    "migration": "tsx scripts/migrate-backend.ts",
    "db:concurrency-test": "vitest run tests/daily-hours-concurrency.int.test.ts",
    "db:password-recovery-test": "vitest run tests/password-recovery.int.test.ts",
    "e2e": "playwright test",
    "a11y": "playwright test e2e/a11y.spec.ts",
    "benchmark": "node scripts/benchmark-endpoints.mjs",
    "benchmark:http": "node scripts/benchmark-endpoints.mjs --http",
    "load": "k6 run load/k6-timesheets.js",
    "matrix:seed": "node scripts/seed-deterministic-matrix.mjs",
    "version:bump": "node scripts/bump-version.mjs patch",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "jose": "^6.2.8",
    "next": "^16.3.8",
    "nodemailer": "10.0.13",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "server-only": "^0.0.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
