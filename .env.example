# Backend mode: "supabase" (default) or "native" (self-contained PostgreSQL +
# in-app auth). It is exposed to the browser via NEXT_PUBLIC_ so the client data
# and auth layers pick the same adapter as the server. Set it once for both.
NEXT_PUBLIC_BACKEND=supabase

# --- supabase mode ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for the admin "Add User" feature (supabase mode only).
SUPABASE_SERVICE_ROLE_KEY=

# --- native mode only (NEXT_PUBLIC_BACKEND=native) ---
# DATABASE_URL=postgres://user:password@postgres:5432/vsis
# AUTH_SECRET=change-me-to-a-long-random-string
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
# SUPER_ADMIN_EMAIL=superadmin@example.com     # optional: gets reset/delete powers in-app
# SUPER_ADMIN_PASSWORD=change-me-super
# MIGRATIONS_DIR=db/migrations                # optional: override migration directory

# --- optional integrations ---
# TELEGRAM_BOT_TOKEN=your-bot-token
