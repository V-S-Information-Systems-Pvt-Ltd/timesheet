# ---------------------------------------------------------------------------
# Backend mode — pick ONE. Exposed via NEXT_PUBLIC_ so the browser and server
# always use the same adapter.
#   supabase  (default) — auth + DB hosted on Supabase.
#   native    — self-contained PostgreSQL + in-app auth (Docker/OpenShift image).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND=supabase

# --- supabase mode (NEXT_PUBLIC_BACKEND=supabase) ---
# Purpose: Supabase project URL + anon key. Both are needed; the anon key is
# safe to expose in the browser because reads are guarded by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Purpose: Server-only Supabase service-role key. Required for admin actions
# that bypass RLS (Add User, Delete User, backups) and recovery-time mobile
# session revocation. NEVER ship to the browser.
# Backend mode: supabase
SUPABASE_SERVICE_ROLE_KEY=

# --- native mode (NEXT_PUBLIC_BACKEND=native) ---
# Purpose: PostgreSQL connection string for the self-hosted DB.
# Backend mode: native
# DATABASE_URL=postgres://user:password@postgres:5432/vsis

# Purpose: Secret used to sign/verify the session JWT (HS256). Must be long
# and random; never commit a real value.
# Backend mode: native
# AUTH_SECRET=change-me-to-a-long-random-string

# Purpose: Separate secret used to sign short-lived mobile bearer access tokens.
# Must be at least 32 random characters; never ship to a mobile client.
# Backend mode: both (required when bearer auth is enabled)
# MOBILE_AUTH_SECRET=change-me-to-a-different-long-random-string

# Purpose: Explicit rollout gate for mobile bearer authentication. Keep false
# until Android Keystore, iOS Keychain, and Windows PasswordVault evidence is
# recorded. Backend mode: both
MOBILE_BEARER_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# Request identity — REQUIRED in any proxied deployment.
# Number of trusted reverse-proxy hops in front of the app (nginx Ingress or
# OpenShift Route = 1; Cloudflare in front of the ingress = 2). The client IP is
# taken that many hops from the RIGHT of x-forwarded-for, so client-injected
# values cannot be trusted.
#
# Leave unset ONLY for direct-to-node deployments. When unset in production,
# getClientIp() fails closed to the literal key "direct-client", which means
# every unproxied request shares ONE rate-limit bucket — cluster-wide once the
# rate-limit store is shared. Vercel does not need this (the platform edge
# supplies x-vercel-forwarded-for).
# Backend mode: both
# TRUSTED_PROXY_HOPS=1

# Purpose: Server-only key used to HMAC rate-limit subjects (emails, IPs) before
# they are persisted. Emails and IPv4 addresses are low-entropy and fully
# enumerable, so a plain digest of them is reversible by dictionary; an HMAC is
# not. Must be at least 32 random characters. Rotating it resets all in-flight
# rate-limit windows, which is safe but forgives current offenders.
# Backend mode: both (required)
# RATE_LIMIT_SUBJECT_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------------------
# Operational endpoints
# ---------------------------------------------------------------------------
# Purpose: Shared secret for the protected cleanup endpoint
# (POST /api/v1/cron/cleanup), presented as `Authorization: Bearer <secret>` or
# `X-Cron-Secret`. REQUIRED in every environment: unset returns 503, mismatch
# returns 403. Must be long and random.
# Backend mode: both (required)
# CRON_SECRET=change-me-to-a-long-random-string

# Purpose: Opt-in verbose /api/health output (version, commit, backend, pool
# metrics, dependency error text). ONLY the exact value `true` enables it.
# Unset, invalid, or `false` returns just {"status":"ok"|"degraded"}. This is an
# explicit diagnostic exposure — enable only on restricted environments.
# Backend mode: both
# HEALTH_DEBUG=false

# Purpose: First admin account email. Seeded by `npm run db:seed`.
# Backend mode: native
# ADMIN_EMAIL=admin@example.com

# Purpose: First admin account password (min 6 chars). Seeded by `npm run db:seed`.
# Backend mode: native
# ADMIN_PASSWORD=change-me

# Purpose: Optional super-admin account. Gets extra powers (reset/delete) in-app.
# Backend mode: native
# SUPER_ADMIN_EMAIL=superadmin@example.com

# Purpose: Super-admin account password (min 6 chars).
# Backend mode: native
# SUPER_ADMIN_PASSWORD=change-me-super

# Native password recovery mail settings. Use a transactional SMTP provider;
# password reset requests remain generic even when delivery is unavailable.
# Backend mode: native
# APP_BASE_URL=https://timesheet.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=VSIS Timesheet <no-reply@example.com>

# ---------------------------------------------------------------------------
# Migrations — directory containing numbered *.sql files.
# Default: ./db/migrations (relative to the repo/working directory).
# Backend mode: native (supabase mode uses supabase/migrations/).
# ---------------------------------------------------------------------------
# MIGRATIONS_DIR=db/migrations

# ---------------------------------------------------------------------------
# End-to-end test credentials — used by e2e/smoke.spec.ts to sign in.
# Must point to a seeded account in whichever backend mode the tests target.
# Backend mode: both
# E2E_EMAIL=admin@example.com
# E2E_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Build metadata — injected at build time for the /api/health endpoint.
# Do NOT set manually; the build process writes this value.
# Backend mode: both
# GIT_COMMIT=
